<Window x:Class="Claculator.MainWindow" Background="Khaki"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Claculator"
        mc:Ignorable="d"
        Title="MainWindow" Height="526" Width="678">
    <Grid Margin="0,0,0,-5">
        <UIElement.RenderTransform>
            <TransformGroup>
                <ScaleTransform/>
                <SkewTransform/>
                <RotateTransform/>
                <TranslateTransform/>
            </TransformGroup>
        </UIElement.RenderTransform>
        <Button Content="Insert" HorizontalAlignment="Left" Margin="427,64,0,0" VerticalAlignment="Top" Height="44" Width="68" ButtonBase.Click="Insert_Click"/>
        <Button Content="Query" HorizontalAlignment="Left" Margin="537,64,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.047,-0.428" Height="40" Width="93" ButtonBase.Click="Query_Click"/>
        <Button Content="1" HorizontalAlignment="Left" Margin="98,176,0,0" VerticalAlignment="Top" ButtonBase.Click="Button_Click_For_Number" Height="39" Width="35"/>
        <Button Content="2" HorizontalAlignment="Left" Margin="170,176,0,0" VerticalAlignment="Top" Click="Button_Click_For_Number" Height="39" Width="35"/>
        <Button Content="3" HorizontalAlignment="Left" Margin="245,176,0,0" VerticalAlignment="Top" Click="Button_Click_For_Number" Height="39" Width="35"/>
        <Button Content="+" HorizontalAlignment="Center" Margin="0,176,0,0" VerticalAlignment="Top" Click="Button_Click_For_Number" Height="39" Width="34"/>
        <Button Content="4" HorizontalAlignment="Left" Margin="98,243,0,0" VerticalAlignment="Top" Click="Button_Click_For_Number" Height="39" Width="35"/>
        <Button Content="5" HorizontalAlignment="Left" Margin="170,243,0,0" VerticalAlignment="Top" Click="Button_Click_For_Number" Height="39" Width="35"/>
        <Button Content="6" HorizontalAlignment="Left" Margin="245,243,0,0" VerticalAlignment="Top" Click="Button_Click_For_Number" Height="39" Width="35"/>
        <Button Content="-" HorizontalAlignment="Center" Margin="0,243,0,0" VerticalAlignment="Top" Click="Button_Click_For_Number" Height="39" Width="35"/>
        <Button Content="7" HorizontalAlignment="Left" Margin="98,313,0,0" VerticalAlignment="Top" Click="Button_Click_For_Number" Height="39" Width="35"/>
        <Button Content="8" HorizontalAlignment="Left" Margin="170,313,0,0" VerticalAlignment="Top" Click="Button_Click_For_Number" Height="39" Width="35"/>
        <Button Content="9" HorizontalAlignment="Left" Margin="245,313,0,0" VerticalAlignment="Top" Click="Button_Click_For_Number" Height="39" Width="35"/>
        <Button Content="*" HorizontalAlignment="Center" Margin="0,313,0,0" VerticalAlignment="Top" Click="Button_Click_For_Number" Height="39" Width="35"/>
        <Button Content="0" HorizontalAlignment="Left" Margin="98,386,0,0" VerticalAlignment="Top" Click="Button_Click_For_Number" Height="39" Width="35"/>
        <Button Content="clear" HorizontalAlignment="Left" Margin="170,386,0,0" VerticalAlignment="Top" Click="Clear" Height="39" Width="35"/>
        <Button Content="=" HorizontalAlignment="Left" Margin="245,386,0,0" VerticalAlignment="Top" Click="Equal" Height="39" Width="35"/>
        <Button Content="/" HorizontalAlignment="Center" Margin="0,386,0,0" VerticalAlignment="Top" Click="Button_Click_For_Number" Height="39" Width="35"/>
        <TextBlock HorizontalAlignment="Left" Margin="427,185,0,0" TextWrapping="Wrap" Text="Preorder" VerticalAlignment="Top" FontSize="16" RenderTransformOrigin="-0.091,0.087"/>
        <TextBlock HorizontalAlignment="Left" Margin="427,246,0,0" TextWrapping="Wrap" Text="Postorder" VerticalAlignment="Top" FontSize="16" RenderTransformOrigin="-0.091,0.087"/>
        <TextBlock HorizontalAlignment="Left" Margin="427,322,0,0" TextWrapping="Wrap"  Text="Decimal" VerticalAlignment="Top" FontSize="16" RenderTransformOrigin="-0.091,0.087"/>
        <TextBlock HorizontalAlignment="Left" Margin="427,394,0,0" TextWrapping="Wrap"  Text="Binary" VerticalAlignment="Top" FontSize="16" RenderTransformOrigin="-0.091,0.087"/>
        <TextBlock x:Name="show" HorizontalAlignment="Left" Text="0" Margin="81,64,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Background="White" Height="58" Width="289" FontSize="24" TextAlignment="Right"/>
        <TextBlock HorizontalAlignment="Left" Margin="508,182,0,0" TextWrapping="Wrap" x:Name="Preorder" Text="0" VerticalAlignment="Top" Background="White" Height="28" Width="152"/>
        <TextBlock HorizontalAlignment="Left" Margin="508,248,0,0" TextWrapping="Wrap" x:Name="Postorder" Text="0" VerticalAlignment="Top" Background="White" Height="28" Width="152"/>
        <TextBlock HorizontalAlignment="Left" Margin="508,318,0,0" TextWrapping="Wrap" x:Name="Decimal" Text="0" VerticalAlignment="Top" Background="White" Height="28" Width="152"/>
        <TextBlock HorizontalAlignment="Left" Margin="508,392,0,0" TextWrapping="Wrap" x:Name="Binary" Text="0" VerticalAlignment="Top" Background="White" Height="28" Width="152"/>
    </Grid>
</Window>
